  <!-- Post-build: Copy to Notepad++ plugins folder -->
  <PropertyGroup>
    <PostBuildEvent Condition="'$(Configuration)' == 'Release'">
      if exist "$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Notepad++\InstallPath)" (
        set "NPP_PATH=$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Notepad++\InstallPath)"
      ) else if exist "$(Registry:HKEY_CURRENT_USER\SOFTWARE\Notepad++\InstallPath)" (
        set "NPP_PATH=$(Registry:HKEY_CURRENT_USER\SOFTWARE\Notepad++\InstallPath)"
      )
      if defined NPP_PATH (
        xcopy /Y "$(TargetDir)*" "%25NPP_PATH%25\plugins\MermaidViewer\" 2&gt;nul
        if not exist "%25NPP_PATH%25\plugins\MermaidViewer" mkdir "%25NPP_PATH%25\plugins\MermaidViewer"
      )
    </PostBuildEvent>
  </PropertyGroup>
